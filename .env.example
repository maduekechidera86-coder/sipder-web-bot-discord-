# 🕸️ SPIDER WEB ⸸ X — environment configuration
# Copy this file to ".env" and fill it in locally.
# ".env" is git-ignored and must NEVER be committed, pasted in chat or shared.

# ── Discord ───────────────────────────────────────────────────────────────
# Developer portal → your application → Bot → Reset Token
DISCORD_TOKEN=

# Developer portal → General Information → Application ID
CLIENT_ID=

# Optional: one server ID. Commands deploy to it instantly while testing.
# Leave empty to register commands globally (can take up to an hour to appear).
GUILD_ID=

# Your own Discord user ID — this unlocks the owner commands.
OWNER_ID=your_discord_user_id

# ── APIs ──────────────────────────────────────────────────────────────────
MEDIA_API_ENDPOINT=https://prexzyapis.com

# ── Optional tuning ───────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
# JSON database location, relative to the project root
DATABASE_PATH=./data/database.json
# Requests to the media/AI API are aborted after this many milliseconds
API_TIMEOUT_MS=15000
# "true" forces global command registration
GLOBAL_COMMANDS=false
